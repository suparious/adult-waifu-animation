# Waifu Animation Chat Configuration - vLLM Example

# Server Settings
HOST=0.0.0.0
PORT=8000

# LLM Configuration for vLLM
LLM_PROVIDER=vllm

# vLLM Endpoint Examples:
# Local vLLM server
LLM_API_URL=http://localhost:8001/v1/completions

# Remote vLLM servers (update with your actual endpoints)
#LLM_API_URL=http://erebus:8081/v1/completions
#LLM_API_URL=http://kratos:8081/v1/completions

# Model Examples (update with your actual model)
LLM_MODEL=solidrust/dolphin-2.9.2-qwen2-7b-AWQ
#LLM_MODEL=Orion-zhen/DeepHermes-3-Llama-3-8B-Preview-AWQ
#LLM_MODEL=TheBloke/Mistral-7B-Instruct-v0.2-AWQ

# API Key (if your vLLM server requires authentication)
LLM_API_KEY=

# LLM Parameters
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=200
LLM_TIMEOUT=30.0

# Features
ENABLE_VOICE_SYNTHESIS=false
ENABLE_ADVANCED_PHYSICS=true
MAX_AFFECTION_LEVEL=100

# Security
CORS_ORIGINS=["http://localhost:3000"]
