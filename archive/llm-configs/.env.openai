# Waifu Animation Chat Configuration - OpenAI Example

# Server Settings
HOST=0.0.0.0
PORT=8000

# LLM Configuration for OpenAI
LLM_PROVIDER=openai

# OpenAI API endpoint
LLM_API_URL=https://api.openai.com/v1/chat/completions

# OpenAI Model Options
LLM_MODEL=gpt-3.5-turbo
#LLM_MODEL=gpt-4
#LLM_MODEL=gpt-4-turbo-preview

# Your OpenAI API Key (required)
# Get one at: https://platform.openai.com/api-keys
LLM_API_KEY=sk-your-openai-api-key-here

# LLM Parameters
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=200
LLM_TIMEOUT=30.0

# Features
ENABLE_VOICE_SYNTHESIS=false
ENABLE_ADVANCED_PHYSICS=true
MAX_AFFECTION_LEVEL=100

# Security
CORS_ORIGINS=["http://localhost:3000"]

# Cost Warning:
# OpenAI charges per token. With these settings:
# - GPT-3.5-turbo: ~$0.002 per chat message
# - GPT-4: ~$0.03 per chat message
# Monitor your usage at: https://platform.openai.com/usage
