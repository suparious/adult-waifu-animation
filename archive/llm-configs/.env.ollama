# Waifu Animation Chat Configuration - Ollama Example

# Server Settings
HOST=0.0.0.0
PORT=8000

# LLM Configuration for Ollama
LLM_PROVIDER=ollama

# Ollama API endpoint (default local installation)
LLM_API_URL=http://localhost:11434

# Ollama Model Examples
# Make sure you've pulled these models with: ollama pull <model>
LLM_MODEL=llama2
#LLM_MODEL=mistral
#LLM_MODEL=neural-chat
#LLM_MODEL=phi
#LLM_MODEL=dolphin-phi
#LLM_MODEL=zephyr

# No API key needed for local Ollama
LLM_API_KEY=

# LLM Parameters (Ollama respects these)
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=200
LLM_TIMEOUT=30.0

# Features
ENABLE_VOICE_SYNTHESIS=false
ENABLE_ADVANCED_PHYSICS=true
MAX_AFFECTION_LEVEL=100

# Security
CORS_ORIGINS=["http://localhost:3000"]

# Note: To use Ollama, you need to:
# 1. Install Ollama: curl -fsSL https://ollama.ai/install.sh | sh
# 2. Pull a model: ollama pull llama2
# 3. Ensure Ollama is running: ollama serve
