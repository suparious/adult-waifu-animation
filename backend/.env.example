# LLM Configuration
# Provider options: vllm, ollama, openai
LLM_PROVIDER=openai
LLM_API_URL=https://artemis.hq.solidrust.net/v1/chat/completions
LLM_API_KEY=srt_prod_your_api_key_here
LLM_MODEL=vllm-primary
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=200
LLM_TIMEOUT=30.0

# PAM Platform Authentication (Issue #2)
# Enable authentication (set to true for production)
ENABLE_AUTH=false
PAM_URL=https://console.solidrust.ai
PAM_VALIDATE_ENDPOINT=/v1/keys/validate
PAM_GRAPHQL_ENDPOINT=/graphql
PAM_TIMEOUT=10.0

# Conversation Memory (Issue #7)
# Enable embeddings-based conversation memory
ENABLE_MEMORY=true
EMBEDDINGS_URL=https://artemis.hq.solidrust.net/v1/embeddings
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_TIMEOUT=30.0
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.7
MEMORY_MAX_AGE_DAYS=90

# Application Features
ENABLE_VOICE_SYNTHESIS=true
VOICE_SYNTHESIS_PROVIDER=webspeech
ENABLE_ADVANCED_PHYSICS=true
MAX_AFFECTION_LEVEL=100
NSFW_ENABLED=true

# CORS Configuration (restrict in production)
# CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
